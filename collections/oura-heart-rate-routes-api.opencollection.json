{
  "opencollection": "1.0.0",
  "info": {
    "name": "Oura API Documentation Daily Activity Routes Heart Rate Routes API",
    "version": "2.0"
  },
  "items": [
    {
      "info": {
        "name": "Heart Rate Routes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Multiple Heartrate Documents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ouraring.com/v2/usercollection/heartrate",
            "params": [
              {
                "name": "start_datetime",
                "value": "",
                "type": "query"
              },
              {
                "name": "end_datetime",
                "value": "",
                "type": "query"
              },
              {
                "name": "next_token",
                "value": "",
                "type": "query"
              },
              {
                "name": "latest",
                "value": "",
                "type": "query",
                "description": "If True, returns most recent sample."
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to include in the response, in addition to the always returned fields. Defaults to all fields if not provided."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Multiple Heartrate Documents"
        }
      ]
    }
  ],
  "bundled": true
}