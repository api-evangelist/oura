  "item": [
    {
      "id": "8fe70528-9e8f-47da-9478-de4721e5aad1",
      "name": "Enhanced Tag Routes",
      "description": {
        "content": "The Enhanced Tags data scope includes tags that Oura users enter within the Oura mobile app. Enhanced Tags can be added for any lifestyle choice, habit, mood change, or environmental factor an Oura user wants to monitor the effects of. Enhanced Tags also contain context on a tag's start and end time, whether a tag repeats daily, and comments.\n\n[Learn more about how Oura users add Enhanced Tags](https://support.ouraring.com/hc/en-us/articles/360038676993-How-to-Use-Tags)",
        "type": "text/plain"
      },
